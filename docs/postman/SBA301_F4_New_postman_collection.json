  "item": [
    {
      "name": "0. Xác thực & Đăng nhập (Auth Login)",
      "description": "Đăng nhập các vai trò để tự động lưu JWT token vào biến collection.",
      "item": [
        {
          "name": "0.1 Đăng nhập Chủ xe (Owner: chuxe@gmail.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập Chủ xe thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"ownerToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.data.accessToken);",
                  "    var id = jsonData.data.account ? jsonData.data.account.id : (jsonData.data.customer ? jsonData.data.customer.id : null);",
                  "    if (id) pm.collectionVariables.set(\"ownerId\", String(id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"chuxe@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "0.2 Đăng nhập Khách thuê (Customer: khach@gmail.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập Khách thuê thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.data.accessToken);",
                  "    var id = jsonData.data.account ? jsonData.data.account.id : (jsonData.data.customer ? jsonData.data.customer.id : null);",
                  "    if (id) pm.collectionVariables.set(\"customerId\", String(id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"khach@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "0.3 Đăng nhập Quản trị viên (Admin: admin@carrental.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập Admin thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
