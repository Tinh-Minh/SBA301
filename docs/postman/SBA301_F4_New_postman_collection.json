    {
      "name": "1. Thanh toán Gói Đăng Tin (Package Payments & VNPay)",
      "description": "Các API tạo thanh toán mua gói cước tin đăng (F3/F4), lấy link VNPay Sandbox, giả lập cổng thanh toán Simulate Gateway.",
      "item": [
        {
          "name": "1.1 Tạo giao dịch thanh toán gói qua VNPay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trả về trạng thái PENDING & có paymentUrl\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.status).to.eql(\"PENDING\");",
                  "    pm.expect(jsonData.data.paymentUrl).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.paymentUrl).to.include(\"vnpayment.vn\");",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"transactionId\", String(jsonData.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": {{subscriptionId}},\n  \"method\": \"VNPAY\",\n  \"bankCode\": \"NCB\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/package-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "package-payment"]
            }
          }
        },
        {
          "name": "1.2 Tạo giao dịch thanh toán gói qua Chuyển khoản (Bank Transfer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tạo giao dịch thành công trạng thái PENDING\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.method).to.eql(\"BANK_TRANSFER\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": {{subscriptionId}},\n  \"method\": \"BANK_TRANSFER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/package-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "package-payment"]
            }
          }
        },
        {
          "name": "1.3 Lấy lại link redirect VNPay Sandbox",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Có link thanh toán VNPay\", function () {",
                  "    pm.expect(jsonData.data.paymentUrl).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.paymentUrl).to.include(\"vnpay\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/vnpay-url?bankCode=NCB",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}", "vnpay-url"],
              "query": [{ "key": "bankCode", "value": "NCB" }]
            }
          }
        },
        {
          "name": "1.4 Xem chi tiết giao dịch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trả về đầy đủ thông tin giao dịch\", function () {",
                  "    pm.expect(jsonData.data.id).to.eql(Number(pm.collectionVariables.get(\"transactionId\")));",
                  "    pm.expect(jsonData.data.amount).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            }
          }
        },
        {
          "name": "1.5 Danh sách giao dịch phân trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Trả về danh sách content dạng mảng\", function () {",
                  "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=0&size=10&sort=id,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "id,desc" }
              ]
            }
          }
        },
        {
          "name": "1.6 [Negative] Chặn Admin không được tạo thanh toán gói cước",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Chặn Admin tạo thanh toán với HTTP 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": {{subscriptionId}},\n  \"method\": \"VNPAY\",\n  \"bankCode\": \"NCB\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/package-payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "package-payment"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Đánh giá Uy tín Xe / Chủ xe (Reviews)",
      "description": "Các API tạo đánh giá theo xe (1-5 sao), xem tổng hợp nhận xét & điểm trung bình của xe, kèm các test chặn lỗi logic.",
      "item": [
        {
          "name": "2.1 Khách gửi đánh giá 5 sao cho xe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Gửi đánh giá thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Thông tin review khớp request\", function () {",
                  "    pm.expect(jsonData.data.rating).to.eql(5);",
                  "    pm.expect(jsonData.data.carId).to.eql(Number(pm.collectionVariables.get(\"carId\")));",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"reviewId\", String(jsonData.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"rating\": 5,\n  \"comment\": \"Xe đi rất êm ái, máy lạnh sâu, chủ xe hỗ trợ nhiệt tình!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
        {
          "name": "2.2 Xem tóm tắt đánh giá & điểm trung bình xe (Public API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Có điểm trung bình và danh sách nhận xét\", function () {",
                  "    pm.expect(jsonData.data.averageRating).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.totalReviews).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.reviews).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{carId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cars", "{{carId}}", "reviews"]
            }
          }
        },
        {
          "name": "2.3 Xem chi tiết đánh giá theo ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Review id khớp\", function () {",
                  "    pm.expect(jsonData.data.id).to.eql(Number(pm.collectionVariables.get(\"reviewId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews", "{{reviewId}}"]
            }
          }
        },
        {
          "name": "2.4 Xem danh sách đánh giá phân trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reviews?carId={{carId}}&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"],
              "query": [
                { "key": "carId", "value": "{{carId}}" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
