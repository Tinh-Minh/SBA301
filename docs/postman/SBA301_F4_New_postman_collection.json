            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"rating\": 4,\n  \"comment\": \"Thử gửi đánh giá lần 2 trùng lặp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Báo cáo Doanh thu Admin (Financial Dashboard)",
      "description": "Các API thống kê doanh thu bán gói của sàn (100% về sàn, không cần đối soát chi trả), số bài đăng đang LISTED, gói bán chạy nhất.",
      "item": [
        {
          "name": "3.1 Báo cáo doanh thu tổng quan bán gói (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin xem dashboard thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Đầy đủ chỉ số tài chính\", function () {",
                  "    pm.expect(jsonData.data.totalRevenue).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.activeListingsCount).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.totalPackagesSold).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.packageStats).to.be.an(\"array\");",
                  "    pm.expect(jsonData.data.recentTransactions).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
