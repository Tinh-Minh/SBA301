                  "    pm.response.to.have.status(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Thông báo lỗi rõ ràng\", function () {",
                  "    pm.expect(jsonData.message).to.include(\"tự đánh giá\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"rating\": 5,\n  \"comment\": \"Xe của tôi tuyệt vời nhất quả đất!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            }
          }
        },
