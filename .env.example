# Copy to .env, or run scripts/setup-supabase.ps1. Never commit real credentials.
# Parsed by Spring as Java properties, NOT by a shell. Do not use export or quote values.
# Use forward slashes in paths; escape literal backslashes as \\ if needed.
# Take host and username from Supabase Connect > Session pooler (port 5432).
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

SERVER_PORT=8080
APP_TIME_ZONE=Asia/Ho_Chi_Minh
JWT_ISSUER=sba301-rentcar
JWT_AUDIENCE=sba301-rentcar-client
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_CLOCK_SKEW=PT30S
# For manual JWT setup, put the Base64 body from each PEM file on one line.
# Inline key values take precedence over file locations when both are configured.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Alternatively, setup-supabase.ps1 fills external file: locations when blank.
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=

# Set this to the exact origin of your frontend. Postman does not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_DOCUMENT_STORAGE_ENABLED=true
# setup-supabase.ps1 fills an existing private directory outside the project when blank.
APP_DOCUMENT_STORAGE_ROOT=

# Explicit one-time provisioning only, using a new dedicated test ADMIN identity.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
