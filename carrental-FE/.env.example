# Next.js rewrite /api/* sang backend Spring. Không commit file .env.local.
BACKEND_URL=http://localhost:8080

# Đặt true chỉ khi muốn dùng dữ liệu mẫu, không gọi backend.
NEXT_PUBLIC_USE_MOCK_API=false

# Để trống để gọi cùng origin (khuyến nghị). Chỉ điền khi frontend gọi thẳng backend.
# NEXT_PUBLIC_API_URL=
