# Copy to config/application-local.properties and activate with the local profile.
# Keep real credentials out of this example and out of version control.
app.time.zone=Asia/Ho_Chi_Minh
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
app.security.jwt.issuer=${JWT_ISSUER}
app.security.jwt.audience=${JWT_AUDIENCE}
app.security.jwt.access-token-ttl=${JWT_ACCESS_TOKEN_TTL:PT30M}
app.security.jwt.clock-skew=${JWT_CLOCK_SKEW:PT30S}
app.security.password.min-length=${PASSWORD_MIN_LENGTH:8}
app.security.password.max-utf8-bytes=${PASSWORD_MAX_UTF8_BYTES:72}
app.security.password.bcrypt-strength=${BCRYPT_STRENGTH:10}
app.security.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:}
app.security.cors.allowed-methods=GET,POST,PUT,PATCH,DELETE,OPTIONS
app.customer.default-page-size=${CUSTOMER_DEFAULT_PAGE_SIZE:20}
app.customer.max-page-size=${CUSTOMER_MAX_PAGE_SIZE:100}
app.customer.status-reason-max-length=${CUSTOMER_STATUS_REASON_MAX_LENGTH:500}
app.customer.status-lock-timeout-ms=${CUSTOMER_STATUS_LOCK_TIMEOUT_MS:5000}
# Storage root must be an existing absolute directory outside the repository and app/artifact tree.
# The application derives protected roots from its CodeSource; it does not create this directory or change ACLs.
app.document.storage.enabled=${APP_DOCUMENT_STORAGE_ENABLED:false}
app.document.storage.root=${APP_DOCUMENT_STORAGE_ROOT:}
app.document.upload.max-file-size=${APP_DOCUMENT_MAX_FILE_SIZE:5MB}
app.document.upload.max-request-size=${APP_DOCUMENT_MAX_REQUEST_SIZE:11MB}
app.document.upload.max-image-pixels=${APP_DOCUMENT_MAX_IMAGE_PIXELS:20000000}
app.document.upload.max-image-dimension=${APP_DOCUMENT_MAX_IMAGE_DIMENSION:10000}
app.document.list.default-page-size=${DOCUMENT_DEFAULT_PAGE_SIZE:20}
app.document.list.max-page-size=${DOCUMENT_MAX_PAGE_SIZE:100}
app.security.bootstrap-admin.enabled=${BOOTSTRAP_ADMIN_ENABLED:false}
app.security.bootstrap-admin.full-name=${BOOTSTRAP_ADMIN_FULL_NAME:}
app.security.bootstrap-admin.email=${BOOTSTRAP_ADMIN_EMAIL:}
app.security.bootstrap-admin.phone=${BOOTSTRAP_ADMIN_PHONE:}
app.security.bootstrap-admin.password=${BOOTSTRAP_ADMIN_PASSWORD:}
