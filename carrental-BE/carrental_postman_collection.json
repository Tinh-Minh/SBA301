    {
      "name": "3. Tranh chấp & Khiếu nại (Disputes)",
      "description": "Các API tạo khiếu nại đơn hàng/phụ phí, đính kèm bằng chứng và giải quyết khiếu nại.",
      "item": [
        {
          "name": "3.1 Mở khiếu nại mới (Create Dispute)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Mở khiếu nại thành công\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.status).to.eql(\"OPEN\");",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"disputeId\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"extraFeeId\": {{extraFeeId}},\n  \"raisedById\": {{renterId}},\n  \"reason\": \"Không đồng ý với phí vệ sinh nội thất\",\n  \"description\": \"Tôi đã tự rửa xe và dọn dẹp sạch sẽ trước khi bàn giao xe trả chủ xe.\",\n  \"evidences\": [\n    {\n      \"uploadedById\": {{renterId}},\n      \"fileUrl\": \"https://supabase.co/storage/v1/object/public/evidences/clean_car_1.jpg\",\n      \"fileType\": \"IMAGE\",\n      \"description\": \"Ảnh chụp khoang xe lúc trả\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/disputes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "disputes"]
            },
            "description": "Khách hàng mở tranh chấp đơn hàng hoặc phụ phí. Trạng thái khởi tạo: OPEN."
          }
        },
        {
          "name": "3.2 Bổ sung bằng chứng khiếu nại (Add Evidence)",
