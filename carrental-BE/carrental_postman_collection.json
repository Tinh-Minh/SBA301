              "raw": "{{baseUrl}}/api/extra-fees/{{extraFeeId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "extra-fees", "{{extraFeeId}}", "pay"]
            },
            "description": "Thanh toán phí phát sinh, chuyển trạng thái từ PENDING sang PAID."
          }
        },
        {
          "name": "2.3 Miễn trừ phí phát sinh (Waive)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/extra-fees',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('authToken') },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            orderId: Number(pm.collectionVariables.get('orderId')),",
                  "            createdById: Number(pm.collectionVariables.get('ownerId')),",
                  "            feeType: 'OTHER',",
                  "            amount: 50000,",
                  "            description: 'Phí phát sinh mẫu để kiểm thử miễn trừ'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        var json = res.json();",
                  "        if (json.data && json.data.id) {",
                  "            pm.collectionVariables.set('extraFeeId', json.data.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Miễn trừ thành công\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.status).to.eql(\"WAIVED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/extra-fees/{{extraFeeId}}/waive?note=Khach+hang+than+thiet+nen+mien+giam",
              "host": ["{{baseUrl}}"],
              "path": ["api", "extra-fees", "{{extraFeeId}}", "waive"],
              "query": [
                {
                  "key": "note",
                  "value": "Khach+hang+than+thiet+nen+mien+giam"
                }
              ]
            },
            "description": "Chủ xe hoặc admin miễn giảm phụ phí (WAIVED). Chú ý dùng method PUT theo code Controller."
          }
        },
