# Copy to .env. Never commit real credentials.
# Parsed by Spring as Java properties, NOT by a shell. Do not use export or quote values.
spring.application.name=carrental
DB_URL=jdbc:postgresql://localhost:5432/carrental
DB_USERNAME=postgres
DB_PASSWORD=

SERVER_PORT=8080
APP_TIME_ZONE=Asia/Ho_Chi_Minh
JWT_ISSUER=sba301-rentcar
JWT_AUDIENCE=sba301-rentcar-client
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_CLOCK_SKEW=PT30S
# Set JWT_SECRET in the process environment; use a new random value of at least 32 UTF-8 bytes.
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_BYTES

# Set this to the exact origin of your frontend. Postman does not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_DOCUMENT_STORAGE_ENABLED=true
APP_DOCUMENT_STORAGE_ROOT=storage/private-documents

# Explicit one-time provisioning only, using a new dedicated test ADMIN identity.
APP_SECURITY_BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
APP_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=

# VNPay sandbox: lay tu tai khoan merchant sandbox cua nhom, KHONG commit gia tri that.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Gmail SMTP credentials. MAIL_PASSWORD must be a Google App Password,
# not the normal Google account password. The sender address uses MAIL_USERNAME.
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:3000

# Dat true cho MOT lan chay de xoa va nap lai du lieu demo (seed_data.sql).
DB_RESET_ON_STARTUP=false
